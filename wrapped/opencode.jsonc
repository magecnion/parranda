{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permissions": [
    { "action": "context7_*", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "opencode run *", "effect": "deny" },
    { "action": "*", "resource": "**/.env*", "effect": "deny" },
    { "action": "*", "resource": "todo", "effect": "deny" },
  ],
  "agents": {
    "plan": {
      "model": "openai/gpt-5.6-lunat#medium",
      "permissions": [
        {
          "action": "edit",
          "resource": "/working-dir/references/plan/*",
          "effect": "allow",
        },
        // {
        //   "action": "external_directory",
        //   "resource": "/working-dir/references/plan/*",
        //   "effect": "allow",
        // },
      ],
    },
    "build": {
      "model": "openai/gpt-5.6-luna-fast",
    },
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
    },
  },
}
