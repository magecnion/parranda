{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    // "todowrite": "allow",
    "context7_*": "allow",
    "task": {
      "*": "ask",
    },
    "bash": {
      // "git diff *": "allow",
      // "git status *": "allow",
      "opencode run *": "deny",
    },
    "read": {
      ".secrets/**": "deny",
      ".env/**": "deny",
      "todo": "deny",
      "**/.env*": "deny",
    },
    "grep": {
      ".secrets/**": "deny",
      ".env/**": "deny",
      "**/.env*": "deny",
      "todo": "deny",
    },
    "list": {
      "**/.env*": "deny",
      ".secrets/**": "deny",
      ".env/**": "deny",
      "todo": "deny",
    },
    "blob": {
      "**/.env*": "deny",
      ".secrets/**": "deny",
      ".env/**": "deny",
      "todo": "deny",
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
  },
}
