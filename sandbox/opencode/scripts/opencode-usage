#!/usr/bin/env node

import { spawnSync } from "node:child_process";

const usage = `Usage: opencode-usage [--today | --all | --session <id>] [--by-model] [--by-project] [--json]

Report token usage from all locally recorded OpenCode sessions.

Options:
  --today     Report from local midnight until now.
  --all       Report all recorded sessions (default).
  --session <id> Report one session and all descendants, including idle - busy timing.
  --by-model  Also show a model-level breakdown.
  --by-project Also show a provider-level breakdown for each project.
  --json      Print the raw OpenCode statistics response.
  --help      Show this help message.`;

const argv = process.argv.slice(2);
let sessionID;
const flags = [];
for (let index = 0; index < argv.length; index++) {
  if (argv[index] !== "--session") {
    flags.push(argv[index]);
    continue;
  }
  const value = argv[++index];
  if (sessionID || !value || value.startsWith("--")) {
    console.error("Use --session once, followed by a session ID.");
    process.exit(2);
  }
  sessionID = value;
}
const args = new Set(flags);
const known = new Set([
  "--today",
  "--all",
  "--by-model",
  "--by-project",
  "--json",
  "--help",
]);

for (const arg of args) {
  if (!known.has(arg)) {
    console.error(`Unknown option: ${arg}\n\n${usage}`);
    process.exit(2);
  }
}

if (args.has("--help")) {
  console.log(usage);
  process.exit(0);
}

if (args.has("--today") && args.has("--all")) {
  console.error("Use either --today or --all, not both.");
  process.exit(2);
}
if (sessionID && ["--today", "--all", "--by-project"].some((flag) => args.has(flag))) {
  console.error("--session cannot be combined with --today, --all, or --by-project.");
  process.exit(2);
}

// SQLite is internal/version-dependent. Snapshot the live database before reading
// a session tree, and fail explicitly if the required schema is unavailable.
const sessionReport = () => {
  const result = spawnSync("python3", ["-c", String.raw`
import json, math, os, sqlite3, subprocess, sys, tempfile

def report():
    path = subprocess.run(["opencode", "debug", "paths", "db"], check=True,
                          capture_output=True, text=True, timeout=30).stdout.strip()
    source = sqlite3.connect(__import__('pathlib').Path(path).resolve().as_uri() + '?mode=ro', uri=True)
    source.execute('PRAGMA query_only=ON')
    fd, snapshot = tempfile.mkstemp(prefix='opencode-usage-', suffix='.db', dir='/tmp/opencode')
    os.close(fd)
    try:
        target = sqlite3.connect(snapshot)
        try:
            source.backup(target)
        finally:
            target.close()
            source.close()
        db = sqlite3.connect('file:' + snapshot + '?mode=ro', uri=True)
        db.row_factory = sqlite3.Row
        try:
            for table, required in {
                'session_v2': {'id', 'parent_id', 'time_busy', 'time_idle'},
                'session_message': {'session_id', 'type', 'data'},
            }.items():
                columns = {row['name'] for row in db.execute('PRAGMA table_info(' + table + ')')}
                if not required <= columns:
                    raise ValueError('Unsupported OpenCode schema: missing columns in ' + table)
            sessions = db.execute('''WITH RECURSIVE tree(id) AS (
                SELECT id FROM session_v2 WHERE id = ?
                UNION
                SELECT s.id FROM session_v2 s JOIN tree t ON s.parent_id = t.id
            ) SELECT s.id, s.time_busy, s.time_idle FROM session_v2 s JOIN tree t ON s.id = t.id''',
                (sys.argv[1],)).fetchall()
            if not sessions:
                raise ValueError('Session not found: ' + sys.argv[1])
            models, timings, issues = {}, [], []
            def number(value):
                return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0
            def add(total, key, value):
                total[key] = total[key] + value if total[key] is not None and number(value) else None
            for session in sessions:
                sid, busy, idle = session['id'], session['time_busy'], session['time_idle']
                valid_busy, valid_idle = number(busy), number(idle)
                state = 'complete' if valid_busy and valid_idle and idle >= busy else 'running' if valid_busy and (idle is None or (valid_idle and idle < busy)) else 'unavailable'
                timings.append({'sessionID': sid, 'busy': busy, 'idle': idle,
                                'elapsedMs': idle - busy if state == 'complete' else None, 'status': state})
                messages = db.execute("SELECT data FROM session_message WHERE session_id = ? AND type = 'assistant'", (sid,)).fetchall()
                if not messages:
                    issues.append(sid + ': no recorded assistant usage')
                for row in messages:
                    try:
                        message = json.loads(row['data'])
                        if not isinstance(message, dict):
                            raise ValueError()
                    except (ValueError, TypeError):
                        issues.append(sid + ': unreadable assistant usage')
                        continue
                    model = message.get('model') or {}
                    if not isinstance(model, dict):
                        model = {}
                    key = tuple(model.get(k) for k in ('providerID', 'id', 'variant'))
                    if not all(value is None or isinstance(value, str) for value in key):
                        key = (None, None, None)
                    total = models.setdefault(key, {'steps': 0, 'input': 0, 'output': 0, 'reasoning': 0,
                                                   'read': 0, 'write': 0, 'cost': 0})
                    total['steps'] += 1
                    tokens = message.get('tokens')
                    tokens = tokens if isinstance(tokens, dict) else {}
                    cache = tokens.get('cache')
                    cache = cache if isinstance(cache, dict) else {}
                    for metric in ('input', 'output', 'reasoning'):
                        add(total, metric, tokens.get(metric))
                    for metric in ('read', 'write'):
                        add(total, metric, cache.get(metric))
                    add(total, 'cost', message.get('cost'))
                    if None in total.values() or not key[0] or not key[1]:
                        issues.append(sid + ': incomplete usage or model metadata')
            models_output = [dict(model=dict(zip(('providerID', 'id', 'variant'), key)), steps=t['steps'],
                cost=t['cost'], tokens={**{k:t[k] for k in ('input', 'output', 'reasoning')},
                    'cache': {'read':t['read'], 'write':t['write']}}) for key,t in models.items()]
            return {'data': {'models': models_output, 'sessions': len(sessions), 'subagents': len(sessions)-1},
                    'session': {'id': sys.argv[1], 'timings': timings, 'issues': sorted(set(issues)),
                                'usageStatus': 'partial' if issues else 'complete'}}
        finally:
            db.close()
    finally:
        os.unlink(snapshot)

try:
    print(json.dumps(report()))
except Exception as error:
    print('Unable to report session usage: ' + str(error), file=sys.stderr)
    sys.exit(1)
`, sessionID], { encoding: "utf8", timeout: 60_000 });
  if (result.error || result.status !== 0) {
    console.error(result.error?.message || result.stderr.trim() || "Session usage request failed.");
    process.exit(1);
  }
  return JSON.parse(result.stdout);
};

const query = new URLSearchParams({ tools: "none" });
if (args.has("--today")) {
  const now = new Date();
  const startOfToday = new Date(now);
  startOfToday.setHours(0, 0, 0, 0);
  // The session-stats endpoint accepts Unix timestamps. ISO date strings cause
  // an HTTP 500 (`Invalid date`) in OpenCode 2.0.12.
  query.set("from", String(startOfToday.getTime()));
  query.set("to", String(now.getTime()));
}

const request = (path) => {
  const result = spawnSync("opencode", ["api", "--standalone", "get", path], {
    encoding: "utf8",
    timeout: 30_000,
  });
  if (result.error) {
    console.error(`Unable to run OpenCode: ${result.error.message}`);
    process.exit(1);
  }
  if (result.status !== 0) {
    console.error(
      result.stderr.trim() ||
        result.stdout.trim() ||
        "OpenCode statistics request failed.",
    );
    process.exit(result.status || 1);
  }
  try {
    return JSON.parse(result.stdout);
  } catch {
    console.error("OpenCode returned an invalid API response.");
    process.exit(1);
  }
};

const response = sessionID ? sessionReport() : request(`/api/experimental/session/stats?${query}`);

if (args.has("--json")) {
  console.log(JSON.stringify(response, null, 2));
  process.exit(0);
}

const data = response.data;
if (!data || !Array.isArray(data.models)) {
  console.error("OpenCode statistics response did not include model usage.");
  process.exit(1);
}

const empty = () => ({
  steps: 0,
  input: 0,
  output: 0,
  reasoning: 0,
  cacheRead: 0,
  cacheWrite: 0,
  cost: 0,
});
const add = (total, item) => {
  const tokens = item.tokens || {};
  const cache = tokens.cache || {};
  total.steps += item.steps || 0;
  for (const [key, value] of Object.entries({ input: tokens.input, output: tokens.output,
    reasoning: tokens.reasoning, cacheRead: cache.read, cacheWrite: cache.write, cost: item.cost })) {
    total[key] = sessionID && (total[key] === null || value == null)
      ? null : total[key] + (value || 0);
  }
  return total;
};

const providerTotals = (stats) => {
  const providers = new Map();
  for (const item of stats.models) {
    const provider = item.model?.providerID || "unknown";
    add(
      providers.get(provider) || providers.set(provider, empty()).get(provider),
      item,
    );
  }
  return providers;
};

const providers = providerTotals(data);

const formatNumber = new Intl.NumberFormat();
const formatCost = new Intl.NumberFormat(undefined, {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 6,
});
const rangeDate = (time) => new Date(time).toLocaleString();
const printRows = (rows) => {
  const headers = [
    "Provider",
    "Steps",
    "Input",
    "Output",
    "Reasoning",
    "Cache read",
    "Cache write",
    "Recorded cost",
  ];
  const values = rows.map(([name, total]) => [
    name,
    formatNumber.format(total.steps),
    ...[total.input, total.output, total.reasoning, total.cacheRead, total.cacheWrite]
      .map((value) => value === null ? "unavailable" : formatNumber.format(value)),
    total.cost === null ? "unavailable" : formatCost.format(total.cost),
  ]);
  const widths = headers.map((header, index) =>
    Math.max(header.length, ...values.map((row) => row[index].length)),
  );
  const line = (row) =>
    row.map((cell, index) => cell.padStart(widths[index])).join("  ");
  console.log(line(headers));
  console.log(widths.map((width) => "-".repeat(width)).join("  "));
  for (const row of values) console.log(line(row));
};

if (sessionID) {
  console.log(`OpenCode usage: ${sessionID} and descendants`);
  console.log(`Usage status: ${response.session.usageStatus}`);
  console.log("Timing: latest busy period per session (idle - busy), not lifetime duration.");
  for (const timing of response.session.timings) {
    console.log(`  ${timing.sessionID}: ${timing.elapsedMs === null ? timing.status : `${(timing.elapsedMs / 1000).toFixed(3)} s`}`);
  }
  for (const issue of response.session.issues) console.log(`Warning: ${issue}`);
} else {
  console.log(`OpenCode usage: ${rangeDate(data.range.from)} – ${rangeDate(data.range.to)}`);
}
console.log(
  `Sessions: ${data.sessions}; subagents: ${data.subagents}; local timezone: ${Intl.DateTimeFormat().resolvedOptions().timeZone}`,
);
console.log("");
printRows([...providers.entries()].sort(([a], [b]) => a.localeCompare(b)));

if (args.has("--by-model")) {
  console.log("\nModel breakdown:");
  const models = new Map();
  for (const item of data.models) {
    const key = `${item.model?.providerID || "unknown"}/${item.model?.id || "unknown"}#${item.model?.variant || "default"}`;
    add(models.get(key) || models.set(key, empty()).get(key), item);
  }
  printRows([...models.entries()].sort(([a], [b]) => a.localeCompare(b)));
}

if (args.has("--by-project")) {
  const projects = request("/api/project");
  if (!Array.isArray(projects)) {
    console.error("OpenCode project list response was invalid.");
    process.exit(1);
  }
  const canonicalCounts = new Map();
  for (const project of projects) {
    const canonical = project.canonical || project.id;
    canonicalCounts.set(canonical, (canonicalCounts.get(canonical) || 0) + 1);
  }
  console.log("\nProject breakdown:");
  for (const project of projects.sort((a, b) =>
    (a.canonical || "").localeCompare(b.canonical || ""),
  )) {
    const projectQuery = new URLSearchParams(query);
    projectQuery.set("project", project.id);
    const projectResponse = request(
      `/api/experimental/session/stats?${projectQuery}`,
    );
    const projectData = projectResponse.data;
    if (
      !projectData ||
      !Array.isArray(projectData.models) ||
      projectData.sessions === 0
    )
      continue;
    const canonical = project.canonical || project.id;
    const label =
      canonicalCounts.get(canonical) > 1
        ? `${canonical} [${project.id.slice(0, 8)}]`
        : canonical;
    console.log(`\n${label} (${projectData.sessions} sessions)`);
    printRows(
      [...providerTotals(projectData).entries()].sort(([a], [b]) =>
        a.localeCompare(b),
      ),
    );
  }
}

// if ([...providers.values()].every((total) => total.cost === 0)) {
//   console.log("\nNote: OpenCode reported $0 recorded cost. Token usage is still valid, but actual billing must come from your provider or configured model pricing.");
// }
